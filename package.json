{
  "name": "smart-agentic",
  "version": "6.2.3-smart.2",
  "description": "SMART — Simulation Methodology based Agentic Research Tool with specialized agents and workflows.",
  "keywords": [
    "research",
    "methodology",
    "smart",
    "ai",
    "agents",
    "science",
    "computational",
    "problem-solving",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "installer",
    "workflow"
  ],
  "homepage": "https://github.com/ishwrknt/rmb-aid#readme",
  "bugs": {
    "url": "https://github.com/ishwrknt/rmb-aid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ishwrknt/rmb-aid.git"
  },
  "license": "MIT",
  "author": "Ishwar",
  "bin": {
    "smart": "./tools/installer/smart-cli.js"
  },
  "files": [
    "src",
    "tools",
    "smart",
    "README.md",
    "LICENSE",
    "install.js"
  ],
  "scripts": {
    "docs:build": "node tools/build-docs.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "install-framework": "node install.js",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 README.md 'smart/*.md' src/smart-skills/smart-pipeline/SKILL.md docs/how-to/release-smart.md docs/how-to/install-smart.md",
    "prepublishOnly": "npm run quality",
    "quality": "npm run format:check && npm run lint && npm run lint:md && npm run docs:build && npm test && npm run validate:refs && npm run validate:skills",
    "test": "npm run test:install && npm run test:refs && npm run test:rehype && npm run test:smart && npm run test:layout && npm run test:helper && npm run test:package",
    "test:helper": "node test/test-smart-install-helper.js",
    "test:install": "node test/test-installation-components.js",
    "test:layout": "node test/test-smart-layout.js",
    "test:package": "node test/test-smart-package.js",
    "test:refs": "node test/test-file-refs-csv.js",
    "test:rehype": "node test/test-rehype-plugins.mjs",
    "test:smart": "node test/smart-metrics/logger.test.js",
    "validate:refs": "node tools/validate-file-refs.js --strict",
    "validate:skills": "node tools/validate-skills.js --strict"
  },
  "dependencies": {
    "@clack/core": "^1.0.0",
    "@clack/prompts": "^1.0.0",
    "@kayvan/markdown-tree-parser": "^1.6.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "csv-parse": "^7.0.3",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.2",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "xml2js": "^0.6.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/starlight": "^0.37.5",
    "@eslint/js": "^9.33.0",
    "astro": "^5.16.0",
    "c8": "^10.1.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-yml": "^1.18.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.1",
    "markdownlint-cli2": "^0.19.1",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^2.5.19",
    "sharp": "^0.33.5",
    "yaml-eslint-parser": "^1.2.3",
    "yaml-lint": "^1.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
